# Public URL the app is served from (used for auth callbacks and cookies)
PUBLIC_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://calepin:calepin@localhost:5432/calepin
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Set to false to disable public sign-up after creating your account
ALLOW_SIGNUP=true
# Optional OIDC single sign-on (Pocket ID, Authentik, Keycloak...)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO

# Backups (daily, configurable in Settings → Backups)
BACKUP_DIR=./data/backups
# Encrypts backups. Keep it safe: without it they can't be restored.
BACKUP_PASSPHRASE=
# Optional S3-compatible off-site copy
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=calepin/
# Time zone for the backup schedule
TZ=America/Toronto

# Uploaded images and files (when Settings → Storage is "On the server")
FILES_DIR=./data/files
MAX_UPLOAD_MB=50
